# Copy this file to .env and fill in what you have.
# Every key is optional: without them the app runs in demo mode.
# Admin → Setup in the app shows which ones are connected.

# ── Database (PostgreSQL) ────────────────────────────────────────────
# Free options: Supabase (click "Connect" in your project and copy the
# "Session pooler" connection string, which works on every network)
# or a local Postgres. Then run: npm run db:migrate && npm run db:seed
# DATABASE_URL="postgresql://postgres:password@localhost:5432/election_verify"

# ── Login and image storage (Supabase, free tier) ────────────────────
# Project Settings → API Keys
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Server only. Never expose it in the browser. Used to upload images.
# SUPABASE_SECRET_KEY="sb_secret_..."

# Emails that become admins on their first sign-in (comma separated)
# ADMIN_EMAILS="you@example.com"

# Public address of the site, used in sign-in emails (optional locally)
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Verification pipeline (each one optional and free) ───────────────
# AI for claims, image notes and the verdict suggestion.
# Google AI Studio → Get API key: https://aistudio.google.com/apikey
# GEMINI_API_KEY="..."
# GEMINI_MODEL="gemini-flash-latest"
# GEMINI_FALLBACK_MODEL="gemini-flash-lite-latest"   # used when the main model is busy

# Existing fact-checks. Google Cloud console → enable "Fact Check Tools API"
# → Credentials → Create API key.
# GOOGLE_FACT_CHECK_API_KEY="..."

# Web search for supporting and contradicting sources (free monthly credits).
# https://app.tavily.com
# TAVILY_API_KEY="tvly-..."
# SEARCH_COUNTRY="india"   # rank results from this country higher; set to "" for worldwide

# ── Background jobs (Inngest, optional) ──────────────────────────────
# Locally: run `npx inngest-cli@latest dev` in a second terminal and set:
# INNGEST_DEV=1
# In production, from a free Inngest account:
# INNGEST_EVENT_KEY="..."
# INNGEST_SIGNING_KEY="..."

# Pause between pipeline steps in milliseconds, so the progress list is easy
# to follow in a presentation. Defaults to 700 in demo mode and 0 with a database.
# PIPELINE_STEP_DELAY_MS=700
